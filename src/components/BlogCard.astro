---
interface Props {
  title: string;
  date: Date;
  slug: string;
}
const { title, date, slug } = Astro.props;
const formattedDate = date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<li>
  <a href={`/blog/${slug}`}>{title}</a>
  <time class="meta" datetime={date.toISOString()}>{formattedDate}</time>
</li>

<style>
  li { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  a { color: var(--color-text-primary); }
  time { flex-shrink: 0; }
  @media (max-width: 760px) { li { display: block; } time { display: block; margin-top: 7px; } }
</style>
