---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import Horizon from '../components/Horizon.astro';
import SocialLinks from '../components/SocialLinks.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Mateus Braga" description="Meu espaço para pensar sobre sistemas, computação e as coisas que descubro pelo caminho.">
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">Olá, eu sou o Mateus.</h1>
    <p class="lead">Sou engenheiro de software. Este é meu espaço para pensar sobre sistemas, computação e as coisas que descubro pelo caminho.</p>
    <p>Um lugar para conectar ideias e compartilhar o que vou aprendendo. Sem pressa de ter tudo pronto.</p>
    <p class="personal-links"><a href="/about">Um pouco sobre mim</a></p>
  </section>
  <Horizon />
  <section class="section" aria-labelledby="writing-title">
    <div class="section-title">
      <h2 id="writing-title">Escritos</h2>
      {posts.length > 5 && <a href="/blog">Todos os textos →</a>}
    </div>
    {posts.length > 0 ? (
      <ul class="post-list">{posts.slice(0, 5).map(post => <BlogCard title={post.data.title} date={post.data.date} slug={post.id} />)}</ul>
    ) : (
      <p class="empty-note">As primeiras páginas ainda estão por vir.</p>
    )}
  </section>
  <section class="section" aria-labelledby="social-title">
    <h2 id="social-title">Me encontre por aí</h2>
    <SocialLinks />
  </section>
</Layout>
