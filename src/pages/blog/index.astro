---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Escritos — Mateus Braga" description="Anotações e descobertas sobre sistemas, computação e o que encontro pelo caminho.">
  <h1>Escritos</h1>
  {posts.length > 0 ? (
    <ul class="post-list">{posts.map(post => <BlogCard title={post.data.title} date={post.data.date} slug={post.id} />)}</ul>
  ) : (
    <div class="prose">
      <p class="empty-note">As primeiras páginas ainda estão por vir.</p>
      <p>Este espaço vai ganhar textos aos poucos, conforme as ideias encontrarem palavras.</p>
      <p><a href="/">Voltar ao início</a></p>
    </div>
  )}
</Layout>
