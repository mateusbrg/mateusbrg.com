---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  image?: ImageMetadata;
  readingTime?: string;
}
const { title, description, date, image, readingTime } = Astro.props;
const formattedDate = date.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={`${title} — Mateus Braga`} description={description} type="article" image={image ? new URL(image.src, Astro.site).href : undefined}>
  <article>
    <a class="back" href="/blog">← Todos os escritos</a>
    <header class="article-header">
      <h1>{title}</h1>
      <p class="summary">{description}</p>
      <p class="meta"><time datetime={date.toISOString()}>{formattedDate}</time>{readingTime && <> · {readingTime}</>}</p>
      {image && <Image src={image} alt="" class="cover" widths={[640, 1280]} sizes="(max-width: 760px) calc(100vw - 48px), 656px" />}
    </header>
    <div class="prose"><slot /></div>
  </article>
</Layout>

<style>
  .back { display: inline-block; font: 13px/1.7 var(--font-ui); margin-bottom: 28px; }
  .article-header h1 { font-size: clamp(30px, 4.4vw, 44px); max-width: 23ch; overflow-wrap: anywhere; }
  .summary { font-size: 18px; color: var(--color-text-muted); }
  .cover { display: block; width: 100%; height: auto; border-radius: 4px; margin-top: 28px; }
</style>
